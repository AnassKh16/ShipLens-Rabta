# Local Compose: replace both password placeholders with the same URL-safe value.
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgresql://rabta:replace-with-local-database-password@db:5432/rabta
TEST_DATABASE_URL=postgresql://rabta:replace-with-local-database-password@db:5432/rabta_test
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
TZ_DISPLAY=Asia/Karachi
# Relative to backend/ for host commands; Compose overrides with an absolute path.
FRONTEND_DIST=../frontend/dist
