{
  "name": "rabta-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . && node scripts/check-styles.mjs",
    "test": "vitest run",
    "verify:build": "node scripts/verify-build.mjs",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.10",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
